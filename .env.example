# cp .env.example .env して使う。.env はコミットしない（.gitignore 済み）
# ここにある値はローカル専用のダミー。AWS では Secrets Manager / SSM Parameter Store から注入する。

# Compose のビルドに bake を使わない（BFF のビルドが host ネットワークを使うため。compose.yaml の bff を参照）
COMPOSE_BAKE=false

# ホスト側で公開するポート
# アプリ（http://localhost:8080 と http://admin.localhost:8080）
NGINX_HOST_PORT=8080
# ログイン画面と Keycloak 管理コンソール
KEYCLOAK_HOST_PORT=8180

# PostgreSQL
POSTGRES_DB=fullstack_lab
POSTGRES_USER=fullstack_lab
POSTGRES_PASSWORD=change-me-local-only

# 外部カレンダーサービス（ローカルは WireMock。キーが空でなければ受け付ける）
EXTERNAL_CALENDAR_API_KEY=local-dummy-key

# Keycloak 管理コンソール（http://localhost:8180）
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# テストユーザー共通のパスワード（alice / bob: 一般利用者、carol / dave: 社員）
LOCAL_TEST_USER_PASSWORD=password

# Maven リポジトリ（Reposilite）。publish 用のトークン名とシークレット。取得は匿名で可能
# ポートはホスト側で公開する番号（http://localhost:8081）
REPOSILITE_HOST_PORT=8081
MAVEN_REPO_USER=publisher
MAVEN_REPO_PASSWORD=change-me-local-only

# OIDC クライアントのシークレット（Keycloak の realm 取り込み時と oauth2-proxy の両方で使う）
CUSTOMER_CLIENT_SECRET=change-me-customer-client-secret
STAFF_CLIENT_SECRET=change-me-staff-client-secret
# 認証 API が Keycloak の Admin API を呼ぶクライアント（サービスアカウント）のシークレット（realm の取り込み時と認証 API の両方で使う）
AUTH_API_CLIENT_SECRET=change-me-auth-api-client-secret

# oauth2-proxy のセッション Cookie の暗号化キー（16 / 24 / 32 バイト）
# 生成例: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=local-only-cookie-secret-32bytes
